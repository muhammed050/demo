# The Delegation local tools server
API_PORT=8787
CLIENT_URL=http://localhost:3000

# Set a long random value before using encrypted credentials in production.
DELEGATION_ENCRYPTION_KEY=replace-with-a-long-random-secret

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8787/api/github/callback

# Vercel OAuth App
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_OAUTH_REDIRECT_URI=http://localhost:8787/api/vercel/callback

# Google OAuth Client
# Enable: Google Identity, Search Console API, Google Analytics Data API, Google Sheets API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/google/callback

# Optional: PageSpeed Insights API key for higher quotas
PAGESPEED_API_KEY=
